        }
      ]
    },
    {
      "id": "claim_4e44cc8d03804d57bb37bfb7e42f654c",
      "statement": "A CriterionScore whose id is absent from the registry is skipped rather than raising, a deliberate robustness choice at a seam where criterion identity crosses two trust boundaries — editable registry YAML and model-returned ids — so a stray id cannot destroy an entire run's results after the LLM budget has been spent.",
      "evidence": [
        {
          "resource": "repo://src/cqg/judge.py#L150-L156",
          "version": "repo-lines-v1:sha256:6d7f480346a1ef13cb40e2b84c27f4663ae3bcd9d5fbea1b87ab58174de6b526:"
