    },
    {
      "id": "claim_f430b9afd3264ecfbcc8cdb22787564a",
      "statement": "A row reaches the Remediation sheet only when its criterion is scored with a score of 2 or less, deliberately excluding not_evaluated criteria because an unjudged criterion is a gap rather than a known defect, and rows are sorted by document then by descending criterion weight so the heaviest fixable criterion comes first.",
      "evidence": [
        {
          "resource": "repo://src/cqg/report.py#L102-L103",
          "version": "repo-lines-v1:sha256:4b4f5e787619488264dcffa72e11b1952331eb3f7c61f63bf052bd5d2da593ed:"
