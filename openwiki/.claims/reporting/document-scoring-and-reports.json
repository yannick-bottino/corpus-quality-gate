  "claims": [
    {
      "id": "claim_bfaa8017a9b24b38a3d5cc230e0bbada",
      "statement": "The global percentage is built in two weighting levels — criterion weight against the registry scale maximum within each dimension, then the registry's dimension_weights across dimensions — and the cross-dimension denominator sums the weights only of dimensions that actually produced a score, so an entirely unevaluated dimension is not treated as a zero.",
      "evidence": [
        {
          "resource": "repo://src/cqg/registry/criteria_registry.yaml#L13-L14",
          "version": "repo-lines-v1:sha256:1e8098a301ca5ddbbc8a1b0c18df47ebaf0ede58182f8bea28131256e675ba13:"
        },
        {
          "resource": "repo://src/cqg/report.py#L12-L29",
          "version": "repo-lines-v1:sha256:aaa35c9f04636ccf11a1ced77f551bfaee34086992d5e52e729f338fea75f7fb:"
        },
        {
          "resource": "repo://tests/test_report_scoring.py#L10-L23",
          "version": "repo-lines-v1:sha256:4b6fa3129bc1884bc6860e51f114ea03d03ce0d24250743ff658a008f303ebee:"
        }
      ]
    },
    {
      "id": "claim_bc668be0f335436894ddfa39c39d3b01",
      "statement": "Only criteria with status scored and a non-null score contribute to either weighting level, so na and not_evaluated rows enter neither numerator nor denominator and a missing judgment never becomes a zero.",
      "evidence": [
        {
          "resource": "repo://src/cqg/report.py#L17-L25",
          "version": "repo-lines-v1:sha256:a4525434c69bfaf0ad3f1196e1d69895ecdfbe80df270681272a6fc3f1473637:"
