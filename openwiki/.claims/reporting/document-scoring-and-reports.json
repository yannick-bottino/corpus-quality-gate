        }
      ]
    },
    {
      "id": "claim_027108c5f71441698794fcb3fd9b3989",
      "statement": "Coverage is scored over scored-plus-not_evaluated with na criteria excluded from both terms, so a document is not penalized for inapplicable criteria but is marked down for criteria that could not be judged; a zero denominator yields 100.0 by documented convention.",
      "evidence": [
        {
          "resource": "repo://src/cqg/report.py#L30-L34",
          "version": "repo-lines-v1:sha256:f699f1cbec16db6a585fd5fc35ecda132d447da0af2ebbded1b6c3ad5765acc7:"
