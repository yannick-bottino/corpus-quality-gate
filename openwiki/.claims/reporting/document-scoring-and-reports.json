        }
      ]
    },
    {
      "id": "claim_ea1aab7abb884065b1219dc1ff43fadf",
      "statement": "Coverage is mechanically depressed by every mechanism that declines to guess — a light-route document has all qualitative criteria not_evaluated, external-dependency criteria are permanently not_evaluated setting a ceiling on any document, and an unjudgeable criterion lands in the same bucket — which raises the low_coverage flag below the configured threshold.",
      "evidence": [
        {
          "resource": "repo://src/cqg/judge.py#L166-L180",
          "version": "repo-lines-v1:sha256:216cebc5cf9627b4cb640f8dfe619a5dafc2a2f9f7a798e2747078ab586beb99:"
