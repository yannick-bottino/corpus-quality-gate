        }
      ]
    },
    {
      "id": "claim_539a5a76f1e64fc1bfa401fd55a74ab9",
      "statement": "The corpus workbook has three sheets named verbatim Synthese, Detail and Remediation, with Detail carrying the per-criterion audit trail of status, justification and evidence and resolving criterion labels from the registry.",
      "evidence": [
        {
          "resource": "repo://src/cqg/report.py#L74-L98",
          "version": "repo-lines-v1:sha256:56dd018c5575692f2f93958481ceaf2c697d958421452e1cb9b6e3bc73e8724b:"
        }
