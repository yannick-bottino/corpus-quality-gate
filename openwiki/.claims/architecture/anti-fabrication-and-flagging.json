  "claims": [
    {
      "id": "claim_562b7a8218aa430e920000574f6d6e6e",
      "statement": "Every criterion in cqg resolves to exactly one of three states declared as a closed Literal type — scored, na, or not_evaluated — so the model layer rejects any other status at construction time rather than letting it reach the report.",
      "evidence": [
        {
          "resource": "repo://src/cqg/models.py#L1-L4",
          "version": "repo-lines-v1:sha256:c36b36e1ffbf6b0f57d5d2ec1f121296a3ca0f1408373fa122f512544d58e0fb:"
        },
        {
