        }
      ]
    },
    {
      "id": "claim_67ff2ad719074c83941035d49bb1a864",
      "statement": "The judge ignores an `na` status asserted by the LLM and demotes it to not_evaluated, because `na` is a decision owned by the deterministic inventory rather than by the model.",
