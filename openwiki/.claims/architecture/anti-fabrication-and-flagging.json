    {
      "id": "claim_fd1358c03e0649c08b4967a9763115a4",
      "statement": "Each non-judged criterion state carries a distinct justification string recording how the value was obtained — \"Signal deterministe.\" for deterministic scores, \"Objet absent du document (inventaire).\" for inventory exclusions, \"Referentiel de questions/cas d'usage absent.\" for criteria depending on an unshipped external reference grid, and \"Route light (crible) : jugement LLM non execute.\" for the light route.",
      "evidence": [
        {
          "resource": "repo://src/cqg/judge.py#L158-L180",
