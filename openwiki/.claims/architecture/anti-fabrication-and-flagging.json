          "version": "repo-lines-v1:sha256:6cc861837a0346e9db689eff8eb16d605c76a59939ea86058307a00165589f50:"
        },
        {
          "resource": "repo://tests/test_models.py#L5-L18",
          "version": "repo-lines-v1:sha256:7dc816b88232edd071bc9da016fc9d7583f1327de969dc64a5e88043dac47d91:"
        }
      ]
    },
    {
      "id": "claim_d3b001be42f04286b44ffcf4fb91ae36",
      "statement": "A criterion may become `scored` only through the `_valid_scored` predicate, which simultaneously requires status scored, an integer score that is explicitly not a bool, a score within the registry scale, and a non-empty justification; any response failing one of these is demoted to not_evaluated.",
      "evidence": [
        {
          "resource": "repo://src/cqg/judge.py#L81-L89",
          "version": "repo-lines-v1:sha256:c78950521733b03255bd6a2f0658c43a886e6c29690b14d8b2d595148fea5c49:"
        },
        {
