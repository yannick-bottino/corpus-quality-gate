    {
      "id": "claim_e4cc31651571424db3b8dbcdba90f9dd",
      "statement": "The data model gains two on-disk types owned by the parse_store layer: `ParsedDocFile`, the sidecar carrying everything a ParsedDoc holds except the markdown plus a schema_version and the `markdown_hash` used to detect hand edits, and `ParseProvenance`, which records the parser, source name, type, sha256, page count, triage category and enrichment flag — and deliberately carries no timestamp, so a --force re-parse does not produce a diff dominated by a clock value.",
      "evidence": [
        {
          "resource": "repo://src/cqg/models.py#L28-L50",
          "version": "repo-lines-v1:sha256:171a3dacaf861bd84500cf720b9591baae53bb8149f9417b2bf9912b966443c1:"
