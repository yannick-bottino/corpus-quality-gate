  "claims": [
    {
      "id": "claim_4f125b1dee9d451f9348548f978dda27",
      "statement": "cqg evaluates intrinsic document quality before RAG ingestion and is reference-free and document-level: it requires neither ground truth nor a query workload, scoring each document on its own observable properties and aggregating to a corpus verdict.",
      "evidence": [
        {
          "resource": "repo://README.md#L1-L6",
          "version": "repo-lines-v1:sha256:483dc03c7c2ee1e0fd55030b9baa8079f31ad54610ede0736b9499fa527bab79:"
        },
        {
          "resource": "repo://src/cqg/cli.py#L162-L202",
          "version": "repo-lines-v1:sha256:5787df098a748b09fe3adf466a3657534a9bb082090e358d5d8cd23de6b39865:"
        }
      ]
    },
    {
      "id": "claim_c42b015481c34e488875c01db466c9aa",
      "statement": "The CLI is a single argument parser exposing exactly three subcommands — `parse`, `run` and `golden` — over a corpus directory with --config, --out, --enrich and --force options, each dispatching into the corresponding module-level entry function; --force is documented as re-parsing a document already present in parsed_input/.",
      "evidence": [
        {
          "resource": "repo://src/cqg/cli.py#L288-L312",
          "version": "repo-lines-v1:sha256:a93c573c4f9bb9213d9e11671560da154f862bbfb3dc5190d84307f4b75eb05b:"
        }
      ]
    },
    {
      "id": "claim_2ff168a429244beca67a5412c6f90266",
      "statement": "The repository is runnable without installation through a root shim that inserts `src/` onto the import path before importing the CLI, while an equivalent `cqg` console script declared in the project manifest points at the same entry function after `pip install -e .`.",
