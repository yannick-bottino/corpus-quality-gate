    },
    {
      "id": "claim_1198ea554c444c79999445e64e504063",
      "statement": "The light route never deletes or downgrades: it skips the LLM call while still producing inventory and deterministic verdicts, emits qualitative criteria as not_evaluated, and attaches a screen:light flag carrying the reasons, so the omission is visible to the reviewer.",
      "evidence": [
        {
          "resource": "repo://src/cqg/cli.py#L125-L131",
