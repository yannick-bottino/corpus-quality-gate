    {
      "id": "claim_d11c268f1c234ae588bf22ca44b7acfe",
      "statement": "The loader does not validate that a criterion's dimension exists in dimension_weights, so an undeclared dimension is accepted at load time and instead raises a KeyError during global percentage computation — after the LLM budget has already been spent.",
      "evidence": [
        {
          "resource": "repo://src/cqg/registry/loader.py#L26-L32",
