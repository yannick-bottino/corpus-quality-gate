    {
      "id": "claim_bed408509cb741408464306f95ead2b6",
      "statement": "The evaluation grid is data rather than code: the 57 criteria, their weights, dimensions and the scoring scale are declared entirely in criteria_registry.yaml, and no pipeline stage hardcodes a criterion's identity or weight.",
      "evidence": [
        {
          "resource": "repo://src/cqg/registry/criteria_registry.yaml#L1-L30",
