    {
      "id": "claim_f7bce8e97f4e4c3ebefc566f12539089",
      "statement": "The global type-token ratio decreases mechanically with document length as vocabulary saturates while the token-count denominator grows, so a long healthy document scores as if degraded — a measured case in this codebase produced a global TTR of 0.0042 on a 222-page document with healthy vocabulary.",
      "evidence": [
        {
          "resource": "repo://src/cqg/signals.py#L52-L65",
          "version": "repo-lines-v1:sha256:7eb1f36b9a44ccc1fdb6d87504f322d7aa0591e48db84018059f8514a7b8c676:"
        },
        {
