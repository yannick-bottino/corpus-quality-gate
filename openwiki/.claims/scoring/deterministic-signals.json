          "version": "repo-lines-v1:sha256:30f96d8aabd76d2a88ee20682dead72df7c9922adb1c4ff334391af19a6c6242:"
        }
      ]
    },
    {
      "id": "claim_df6d4aa6500a4718a27d4a11faeeda8e",
      "statement": "MATTR removes the length dependence by averaging the TTR of fixed-size token windows so every window shares a denominator, and it reduces exactly to the global TTR for text shorter than one window — both properties pinned by test.",
      "evidence": [
        {
