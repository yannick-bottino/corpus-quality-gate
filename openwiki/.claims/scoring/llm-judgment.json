    {
      "id": "claim_4c4f595106084d46a6f2c2e5594b909b",
      "statement": "_split_sections walks the markdown in windows advancing by a stride of size minus overlap, defaults the overlap to one tenth of the section size, and clamps overlap to be strictly less than the size so the stride is at least 1 and the walk always progresses.",
      "evidence": [
        {
          "resource": "repo://src/cqg/judge.py#L36-L57",
          "version": "repo-lines-v1:sha256:857333b02b27e323ff00f539df92b8f47c335141c79befb16d0307cdea8c218a:"
