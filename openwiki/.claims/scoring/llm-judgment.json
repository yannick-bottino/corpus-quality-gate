        }
      ]
    },
    {
      "id": "claim_655daf441a2142ca95d16d53c060f734",
      "statement": "Overlap exists so that evidence spanning a section boundary stays fully visible in at least one window, since a passage cut in half would leave both neighbouring sections with a fragment supporting no confident judgment.",
      "evidence": [
        {
          "resource": "repo://src/cqg/judge.py#L36-L45",
