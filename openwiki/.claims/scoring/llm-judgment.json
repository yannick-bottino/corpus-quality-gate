          "version": "repo-lines-v1:sha256:dd9b22f1d53eb0ff9081569361f6bbb612431ec515df60a602a1000632e65da5:"
        }
      ]
    },
    {
      "id": "claim_926965ec673e496197949232b238b1fe",
      "statement": "Sectioning guarantees coverage by union rather than partition: every character lands in at least one section and overlap-region characters land in two, verified by tests showing exact reconstruction at zero overlap and reconstruction from the first section plus subsequent tails when overlapping, with consecutive sections genuinely sharing their boundary region.",
      "evidence": [
        {
          "resource": "repo://src/cqg/judge.py#L36-L57",
          "version": "repo-lines-v1:sha256:857333b02b27e323ff00f539df92b8f47c335141c79befb16d0307cdea8c218a:"
