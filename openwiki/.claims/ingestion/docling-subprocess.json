    },
    {
      "id": "claim_31d947b54f3442c5b72e1c9b033980c4",
      "statement": "A failing batch degrades to pdfminer text for just those pages rather than losing the document, and the pdfminer extraction of the whole document is computed lazily on the first batch failure and reused thereafter, so a fully successful run never pays for it.",
      "evidence": [
        {
          "resource": "repo://src/cqg/parse.py#L145-L171",
          "version": "repo-lines-v1:sha256:d3ed7902e980bd9a081bd7e72aa74ba2d3e1141c1544bd04fb7396c49b06fcac:"
        }
      ]
    },
    {
      "id": "claim_bd2b95589c744c6a87f4ce32d4cf53d7",
      "statement": "The Docling attempt is abandoned to the legacy pdfminer + pdfplumber chain only when it produces no content at all, in which case _docling_extraction raises RuntimeError and parse_document swallows it, so no Docling failure ever propagates to the caller.",
      "evidence": [
        {
          "resource": "repo://src/cqg/parse.py#L172-L174",
          "version": "repo-lines-v1:sha256:44ef03c5dacc88a54da85270b06bae6c7eb0a135afe3b5467af48b04b23fec1c:"
