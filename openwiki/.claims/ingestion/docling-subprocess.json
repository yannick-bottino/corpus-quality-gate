    {
      "id": "claim_e306afc2ea754334bbdc8dc11636d7e9",
      "statement": "Text blocks derived from Docling markdown are assigned page 0 because the batch markdown does not preserve per-paragraph page attribution, so the page is left unasserted rather than inferred.",
