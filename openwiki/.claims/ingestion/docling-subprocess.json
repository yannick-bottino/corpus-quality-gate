    {
      "id": "claim_0f7c674c862e4d64a1bf39c89a322ad8",
      "statement": "The recorded parsing benchmark shows the legacy pdfminer path extracts clean text yet flattens guarantee tables by serializing columns separately — measuring one label separated from its own value by roughly 17,000 characters — which destroys the label-to-value association a RAG chunk needs while Docling preserves it as Markdown table rows; this is the evidence justifying table-structure recognition as the reason to prefer Docling despite its cost.",
      "evidence": [
        {
          "resource": "repo://docs/benchmark-docling-cahier-ma-sante.md#L1-L36",
          "version": "repo-lines-v1:sha256:8d37a128d2e40e514ec838068a7d4162b426312380b20f6b8f865355513f8ced:"
