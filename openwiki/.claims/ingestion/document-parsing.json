    {
      "id": "claim_a860ccf11d8d462985d34a1a6d1dddc2",
      "statement": "Above a cid-fraction threshold the chain attempts a pdfplumber re-extraction, and _better_extraction adopts it only if it STRICTLY reduces the cid fraction, keeping the primary result on equal fractions; the attempt is wrapped so a failing re-extraction leaves the primary intact.",
      "evidence": [
        {
          "resource": "repo://src/cqg/parse.py#L112-L125",
          "version": "repo-lines-v1:sha256:eb1ffbe75d5d51f574d5f26f5e6287883d195f565a9cf7d6822758ba2c3a058a:"
