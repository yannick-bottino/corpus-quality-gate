    {
      "id": "claim_bf40319235914a13a7332f220bbc669c",
      "statement": "Triage classifies PDFs into scanned, born_digital or mixed from words-per-page and images-per-page thresholds computed with pypdf, and returns the `unreadable` category rather than raising when pypdf cannot open the file at all.",
