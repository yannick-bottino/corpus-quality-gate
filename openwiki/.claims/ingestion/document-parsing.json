    {
      "id": "claim_849893926f3c48d096e1df85fd388c05",
      "statement": "Triage enumerates the corpus directory non-recursively in sorted order over five admitted extensions (.pdf, .docx, .pptx, .txt, .md), giving a stable and reproducible document order across runs.",
      "evidence": [
        {
          "resource": "repo://src/cqg/triage.py#L38-L41",
