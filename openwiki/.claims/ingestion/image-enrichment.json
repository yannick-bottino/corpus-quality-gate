          "version": "repo-lines-v1:sha256:e1e3064714fd0b2446bc9c278cada03c8c5a53af2851fcd78e07f977a08539c0:"
        }
      ]
    },
    {
      "id": "claim_698c4a7a33024792be9b1b0d2088d2f8",
      "statement": "The enriched markdown is persisted as <doc_id>.enriched.md so a reviewer can inspect exactly what was judged, and a test confirms the file is written containing the injected description text.",
