    {
      "id": "claim_b531ecdfe66343baa112bc5bf0030492",
      "statement": "The run counts the unverified-description tag in the markdown it is about to score and attaches the count as an `auto_descriptions:<n>` flag, giving a reviewer an audit trail for how much of the scored text was machine-written; the count is matched on the opening of the tag rather than on the marker string alone, so prose merely quoting the marker — an .enriched.md from an earlier run fed back in as a raw source — cannot claim descriptions the document never received.",
      "evidence": [
        {
          "resource": "repo://src/cqg/cli.py#L275-L278",
          "version": "repo-lines-v1:sha256:b19893c2881f1a1e47e38823d8e742474b9453131634f2380fdbc968d561dc8d:"
