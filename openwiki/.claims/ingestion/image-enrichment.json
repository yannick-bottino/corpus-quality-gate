        }
      ]
    },
    {
      "id": "claim_22c58d2547254bfaad461ab979bc3bd0",
      "statement": "Each ImageRef resolves to exactly one of three substitutions: an image whose bounding box has a side below min_side_pts is replaced by `[Image decorative ignoree]` with no render and no model call, a successful description is wrapped in `[Image (description automatique, non verifiee): {desc}]`, and any exception yields `[Image non decrite: {type}]` naming the exception type.",
      "evidence": [
        {
          "resource": "repo://src/cqg/enrich.py#L26-L28",
          "version": "repo-lines-v1:sha256:f79e41c0ff916bb4493ec66aad511afae00566e6315277d8c7078fb7ec320aed:"
        },
        {
          "resource": "repo://src/cqg/enrich.py#L39-L58",
