    {
      "id": "claim_01c4e953a0c04cb48249237bec2adb6d",
      "statement": "ManualVLM turns enrichment into a two-pass human-in-the-loop workflow: its describe_image records each image and returns an empty string so every placeholder survives pass one, and the run calls flush() when the client supports it to persist the manifest and return its path as image_manifest in the run result.",
      "evidence": [
        {
          "resource": "repo://src/cqg/cli.py#L152-L156",
          "version": "repo-lines-v1:sha256:dda6d6a8a2864cbe30928461d3d113a3bf7ff7566dccd6858c889c2175cc66c4:"
