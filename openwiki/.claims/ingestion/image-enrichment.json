        }
      ]
    },
    {
      "id": "claim_97185616382f4c9b9f3564eca7c44796",
      "statement": "Image size is the sole criterion for the decorative decision, so an image that passes the size filter but receives an empty description leaves its placeholder intact rather than being labelled decorative — an explicit invariant pinned by separate tests for enrich_document and apply_descriptions.",
      "evidence": [
        {
          "resource": "repo://src/cqg/enrich.py#L40-L45",
