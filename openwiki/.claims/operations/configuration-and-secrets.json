    {
      "id": "claim_2d4b9509b69d4e54a0480781a7f630b5",
      "statement": "Configuration never stores a credential value: the api_key_env field holds the NAME of an environment variable which the provider resolves from the process environment, so a config file can be committed or shared without carrying a secret and key rotation is an environment change rather than a repository change.",
      "evidence": [
        {
          "resource": "repo://README.md#L20-L21",
          "version": "repo-lines-v1:sha256:64a36a1575583a8fec74e710219cceda908b4baf466f9b4dacc16a08b1d14144:"
        },
