          "version": "repo-lines-v1:sha256:2b20af288d9b8d0bdf26b936fc164577ec34bbfed77b6e9aaabe21b7b63266b0:"
        }
      ]
    },
    {
      "id": "claim_df001641b561450cae41d1b120af71d3",
      "statement": "The vision client is constructed only when enrichment is active because a provider resolves its credential at construction, so building it unconditionally would make an enrichment API key a prerequisite for every run including those that never describe an image; on a parsed_input/ the flag is cleared before that construction, so no credential is demanded to do nothing.",
      "evidence": [
        {
          "resource": "repo://src/cqg/cli.py#L221-L233",
          "version": "repo-lines-v1:sha256:eca17fe7230381d8a62003c45944e36f7de995a298030e106f90d74f0b32fff3:"
        },
        {
          "resource": "repo://src/cqg/llm/providers.py#L24-L30",
          "version": "repo-lines-v1:sha256:9add202e5e1c6292fc0fbeef9a26fffaddce9a3bf4d3070e686ab92af6f78df5:"
        }
      ]
    },
    {
      "id": "claim_cfa99470d8434ccc8296b88ddf0c6d22",
      "statement": "Enrichment runs before evaluation and its output replaces the document's markdown for all downstream stages, so quality is scored on the text that will actually be ingested into RAG rather than on raw text carrying opaque placeholders.",
      "evidence": [
        {
          "resource": "repo://src/cqg/cli.py#L265-L274",
          "version": "repo-lines-v1:sha256:56e923b4f8a13f2bbbcb55e38ce13d392ceb703dffa9911604bdcdbeadbc7f05:"
        },
        {
