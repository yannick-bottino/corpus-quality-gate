    {
      "id": "claim_82aa6abc88444fd4b40f07d031c1f742",
      "statement": "The orchestration attaches its own flags after document scoring — screen:light with the screen's reasons and auto_descriptions with the count — on top of the low_coverage and low_parse_confidence flags that document scoring raises itself.",
