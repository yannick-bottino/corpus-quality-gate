        }
      ]
    },
    {
      "id": "claim_b4971843aadc4010a6624bf45dc9c1ef",
      "statement": "Parsed entries are yielded by a generator rather than collected into a list, because a parsed entry carries its blocks and materialising a whole corpus of them upfront would undo the bounded memory the per-page parsing buys.",
      "evidence": [
        {
          "resource": "repo://src/cqg/cli.py#L28-L41",
