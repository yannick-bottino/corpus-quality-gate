        }
      ]
    },
    {
      "id": "claim_6ba3aac9beb44c6f990181959b4b8a75",
      "statement": "The run fingerprint is computed once before the loop and stamped into every DocScore, including those produced on the unreadable and processing-error paths that never reach normal scoring.",
