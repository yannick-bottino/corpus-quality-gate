          "version": "repo-lines-v1:sha256:b69c0522d35475044401c167c5b7a1d241a0472ed1301d2303689263cee25dd4:"
        }
      ]
    },
    {
      "id": "claim_0473abf8c25844e9967a3868adce6cbb",
      "statement": "The unreadable path is a deliberate short-circuit that skips metrics, screening and judgment specifically to avoid spending an LLM call on empty content, and it also withholds the document from the parsed-text list feeding duplicate detection.",
      "evidence": [
        {
          "resource": "repo://src/cqg/cli.py#L118-L119",
          "version": "repo-lines-v1:sha256:15ca4be6672438eccd5e1635776fa66fdf598ec6f2498be8ff523c85d64166e8:"
