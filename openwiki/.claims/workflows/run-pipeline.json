        }
      ]
    },
    {
      "id": "claim_b9b27dbb816a4a7dbdd02b5b786e4414",
      "statement": "After the loop the orchestration writes the corpus deliverables — the Excel workbook with its CSV mirrors, corpus_redundancy.json and cost.json — and returns a summary of report paths, document and error counts, and artifact locations.",
      "evidence": [
        {
          "resource": "repo://src/cqg/cli.py#L143-L151",
