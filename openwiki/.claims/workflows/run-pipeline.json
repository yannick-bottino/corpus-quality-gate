  "claims": [
    {
      "id": "claim_1c21d4a0f5244f089b99131a2d7f0f4a",
      "statement": "The run orchestration performs its setup once before the document loop — loading the registry, building and instrumenting the judge LLM, computing the run fingerprint, and creating the output directory up front so partial results survive an interrupted run.",
      "evidence": [
        {
          "resource": "repo://src/cqg/cli.py#L66-L77",
          "version": "repo-lines-v1:sha256:d1baacf3a12c49576e687d9db8576b8600a5b953e28c4d7b9ef49595275ec4e8:"
        }
      ]
    },
    {
      "id": "claim_f01f5710aaa9461991f7c4e9fd8c846e",
      "statement": "Configuration is read at the orchestration level and passed to stages as plain arguments rather than as a config dict, which is what allows each stage to be tested in isolation with synthetic inputs.",
      "evidence": [
        {
          "resource": "repo://src/cqg/cli.py#L120-L129",
          "version": "repo-lines-v1:sha256:1070799bf7055fd2b37e4a72328425865607323e63ab5d1fa2ce9e78ea3c969a:"
        },
        {
          "resource": "repo://src/cqg/cli.py#L72-L84",
          "version": "repo-lines-v1:sha256:767923a41a8307f113bfae55f14ecd4c5835812d82debc6c74b24e8529c3e6f4:"
        },
        {
          "resource": "repo://tests/test_screen.py#L1-L27",
          "version": "repo-lines-v1:sha256:2b20af288d9b8d0bdf26b936fc164577ec34bbfed77b6e9aaabe21b7b63266b0:"
        }
      ]
    },
    {
      "id": "claim_df001641b561450cae41d1b120af71d3",
      "statement": "The vision client is constructed only when enrichment is active because a provider resolves its credential at construction, so building it unconditionally would make an enrichment API key a prerequisite for every run including those that never describe an image.",
      "evidence": [
        {
          "resource": "repo://src/cqg/cli.py#L80-L89",
          "version": "repo-lines-v1:sha256:9376626d533774a52255edd4be2daa2a5623d47e247fa68e41fcbcc5593cf0ee:"
        },
        {
          "resource": "repo://src/cqg/llm/providers.py#L24-L30",
          "version": "repo-lines-v1:sha256:9add202e5e1c6292fc0fbeef9a26fffaddce9a3bf4d3070e686ab92af6f78df5:"
        }
      ]
    },
    {
      "id": "claim_cfa99470d8434ccc8296b88ddf0c6d22",
      "statement": "Enrichment runs before evaluation and its output replaces the document's markdown for all downstream stages, so quality is scored on the text that will actually be ingested into RAG rather than on raw text carrying opaque placeholders.",
      "evidence": [
        {
          "resource": "repo://src/cqg/cli.py#L106-L117",
          "version": "repo-lines-v1:sha256:e0a5b72d2cf458c6476ddc25171cfbed94fd3db012ecbeff847c59db8d0d6cd7:"
        },
        {
          "resource": "repo://tests/test_cli_e2e.py#L100-L120",
          "version": "repo-lines-v1:sha256:e1e3064714fd0b2446bc9c278cada03c8c5a53af2851fcd78e07f977a08539c0:"
        }
      ]
    },
    {
      "id": "claim_542bbe61831f47c5a3ea6329e8af5beb",
      "statement": "The counter is reset immediately before judging each document and the resulting call and prompt-character counts are recorded immediately after, which is what makes cost.json report per-document rather than cumulative corpus figures.",
      "evidence": [
        {
          "resource": "repo://src/cqg/cli.py#L124-L128",
          "version": "repo-lines-v1:sha256:7c88d82da53d7c6a9651031fcefff8a8f2af630f5af56caffcf8edbef4166175:"
        },
        {
          "resource": "repo://src/cqg/llm/instrument.py#L32-L34",
          "version": "repo-lines-v1:sha256:e2e68f76997528212d53167fb108e94821aee1cf22fa5f09db77d99f2df132ac:"
        }
      ]
    },
    {
      "id": "claim_47ca746eb5e844c9a5e9acc224359c76",
      "statement": "Every document leaves the per-document loop by exactly one of four paths — an unsupported format flagged before parsing, empty markdown flagged unreadable, an exception flagged processing_error, or normal scoring — and all four write a score file so no input is ever silently dropped.",
      "evidence": [
        {
          "resource": "repo://src/cqg/cli.py#L95-L156",
          "version": "repo-lines-v1:sha256:8edcbf43869cfe4ebb083a44b0e0ed887df62fb86da7a528728a001fbc8160a7:"
        },
        {
          "resource": "repo://tests/test_cli_e2e.py#L183-L203",
